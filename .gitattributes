# Normalise all text to LF in the repository and in the working tree.
#
# Without this, a checkout on Windows with core.autocrlf=true produces CRLF files, and
# `ruff format --check` (configured with line-ending = "lf") then flags every file in the
# project. Pinning LF here keeps `make check` passing identically on every platform.
* text=auto eol=lf

# Binary and generated artefacts: never touch line endings.
*.png binary
*.pdf binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
*.npy binary
*.npz binary
*.parquet binary

# Notebooks are JSON: diff them as text, but they are noisy, so keep them out of merge
# resolution. Outputs are stripped on commit by the nbstripout pre-commit hook.
*.ipynb text eol=lf merge=binary
