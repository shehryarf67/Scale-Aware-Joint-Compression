# ---------------------------------------------------------------------------
# Data (directory structure is tracked, contents are not)
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/calibration/*
!data/calibration/.gitkeep

# ---------------------------------------------------------------------------
# Run artefacts (directory structure is tracked, contents are not)
# ---------------------------------------------------------------------------
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/benchmarks/*
!outputs/benchmarks/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# ---------------------------------------------------------------------------
# Results: raw and processed artefacts are large; curated summaries are tracked
# ---------------------------------------------------------------------------
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep
results/summaries/*
!results/summaries/.gitkeep
!results/summaries/*.md

# ---------------------------------------------------------------------------
# Catch-all for the three artefact roots.
#
# The rules above only name the subdirectories that existed when they were written. A run writes to
# `outputs/<experiment_id>/`, which none of them match -- so the first real compressed run left
# `outputs/pilot/checkpoint/` untracked *and unignored*, one `git add -A` away from being committed.
# These patterns close that: everything under the three roots is ignored, with directories
# re-included so git can still descend to the tracked `.gitkeep` files.
#
# Enforced by tests in tests/test_repository.py, because the hard rule ("never commit anything under
# outputs/, results/ or data/") should not depend on anyone remembering it.
# ---------------------------------------------------------------------------
outputs/**
!outputs/**/
!outputs/**/.gitkeep
results/**

# EXCEPTION: the committed evidence set. `results/**` above exists because run artefacts are large,
# transient and often licence-encumbered -- but it also meant the only copy of every number in
# docs/findings_log.md lived in an ignored directory, so a fresh clone could not recompute a single
# table. These four plain-text files close that gap and nothing more: normalised cells, per-replicate
# joint gains against best-of-sequential, per-window NLL for the paired bootstrap, and a sha256 per
# source record so excluded artefacts stay identifiable. Regenerate with scripts/export_evidence.py;
# a test asserts the committed set is current.
!results/evidence/
!results/evidence/**
!results/**/
!results/**/.gitkeep
!results/summaries/*.md
data/**
!data/**/
!data/**/.gitkeep

# Large tabular exports anywhere in the tree
*.parquet
*.feather
*.arrow

